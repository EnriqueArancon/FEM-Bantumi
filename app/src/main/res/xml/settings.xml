<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/prefTituloCategoria1">

        <EditTextPreference app:key="nombreJugador" app:title="@string/prefTituloNombreJugador" app:dialogTitle="@string/prefTituloNombreJugador" app:summary="@string/prefTextoNombreJugador" app:defaultValue="@string/txtPlayer1" app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/prefTituloCategoria2">

        <ListPreference
            app:key="numInicialSemillas"
            app:title="@string/prefTituloNumSemillas"
            app:dialogTitle="@string/prefTituloNumSemillas"
            app:entries="@array/numSemillasEntries"
            app:entryValues="@array/numSemillasValues"
            app:defaultValue="4"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>
